# ======================================
# Rust / Cargo
# ======================================

# Cargo build output
/target/
**/target/

# Generated by Cargo (debug profile)
/debug

# Local environment files
/.cargo/
# ...except the sccache wrapper config, which is meant to be shared.
!/.cargo/config.toml
# Uncomment to ignore Cargo.lock for libraries
# /Cargo.lock

# Android build artifacts (regenerated by cargo-ndk / Gradle — see deploy_android.ps1)
android/app/src/main/jniLibs/
android/app/src/main/assets/
android/app/build/
android/.gradle/
android/local.properties

# Rust analyzer cache (optional)
/.rustc_info.json

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows PDB debug info
*.pdb

# Mutation testing output
**/mutants.out*/

 ======================================
# Logs
# ======================================

/logs/
*.log

# ======================================
# OS / Editor garbage
# ======================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ======================================
# IDE / Editor
# ======================================

# Visual Studio Code
.vscode/
.history/

# JetBrains IDEs
.idea/

# Sublime
*.sublime-project
*.sublime-workspace

# RustRover (JetBrains Rust IDE)
# Full exclusion is optional:
# .idea/

# ======================================
# Project-specific
# ======================================

# Local assets overrides
assets/temp/
assets/debug/

# You explicitly requested this folder:
# (Not a Cargo default — safe to ignore)
 /src/target/

# patch files
*.patch
*.diff

# ======================================
# litastum
# ======================================

# Command-line history (command_line/history.rs) -- a plain file next
# to the binary/repo root for now (cwd-relative, not the OS config
# dir), so it lands here during `cargo run`/`cargo test` from the repo
# root and shouldn't be committed.
/command_history.txt

# Editor search history (editor/find_history.rs) -- same cwd-relative
# shortcut as command_history.txt above, separate file.
/editor_search_history.txt

# Debug scratch folder for manual explorer/panel testing -- purely
# local, never committed (including generate_test_files.bat itself,
# which creates 100 numbered files, 1.txt-100.txt, content matching
# the filename, for manually testing panel scrolling/navigation).
/temp

# F2 user menu (explorer/user_menu) -- per-directory local files, left
# unanchored so they're caught wherever F2 creates/reads one (any
# subdirectory used while testing), not just the repo root. The .bak
# suffix covers the backups state::port_far_menu/
# backup_far_menu_without_porting make of either file before
# overwriting/moving it.
LitastumMenu.toml
LitastumMenu.toml.bak
FarMenu.ini
FarMenu.ini.bak