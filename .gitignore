# ======================================
# Rust / Cargo
# ======================================

# Cargo build output
/target/
**/target/

# Generated by Cargo (debug profile)
/debug

# Local environment files
/.cargo/
# ...except the sccache wrapper config, which is meant to be shared.
!/.cargo/config.toml
# Uncomment to ignore Cargo.lock for libraries
# /Cargo.lock

# Android build artifacts (regenerated by cargo-ndk / Gradle — see deploy_android.ps1)
android/app/src/main/jniLibs/
android/app/src/main/assets/
android/app/build/
android/.gradle/
android/local.properties

# Rust analyzer cache (optional)
/.rustc_info.json

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows PDB debug info
*.pdb

# Mutation testing output
**/mutants.out*/

# ======================================
# Bevy / Assets
# ======================================

*.png.cache
*.shadercache
*.shader
*.spv

# ======================================
# Logs
# ======================================

/logs/
*.log

# ======================================
# OS / Editor garbage
# ======================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ======================================
# IDE / Editor
# ======================================

# Visual Studio Code
.vscode/
.history/

# JetBrains IDEs
.idea/

# Sublime
*.sublime-project
*.sublime-workspace

# RustRover (JetBrains Rust IDE)
# Full exclusion is optional:
# .idea/

# ======================================
# Project-specific
# ======================================

# Local assets overrides
assets/temp/
assets/debug/

# You explicitly requested this folder:
# (Not a Cargo default — safe to ignore)
 /src/target/

# patch files
*.patch
*.diff
