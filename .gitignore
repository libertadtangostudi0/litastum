# ======================================
# Project-specific
# ======================================

# Local assets overrides
assets/temp/
assets/debug/

# You explicitly requested this folder:
# (Not a Cargo default — safe to ignore)
 /src/target/

# patch files
*.patch
*.diff

# ======================================
# litastum
# ======================================

# The real per-user config.json (theming/config/mod.rs -- theme/shell/
# popup-style choices, tunable Limits overrides) normally lives in the
# real OS config directory (%APPDATA%\litastum\ or equivalent), never
# here -- this entry only matters because `LITASTUM_CONFIG_DIR` (see
# .claude/rules/litastum-config.md) is routinely pointed at this exact
# checkout for local development/testing, which writes a real,
# developer-machine-specific config.json straight into the repo root.
/config.json

# Command-line/editor-search/Find-file history (command_line/history.rs,
# editor/find_history.rs, explorer/find_file/history.rs) now lives in
# `history/` directly under the repo root (`src/history_dir.rs`,
# CARGO_MANIFEST_DIR-anchored) -- real, developer-machine-specific
# history, never committed. Never the OS config dir either -- see
# history_dir.rs's own doc comment for why (this app never reads/writes
# anything outside its own directory tree).
/history/

# Debug scratch folder for manual explorer/panel testing -- purely
# local, never committed (including generate_test_files.bat itself,
# which creates 100 numbered files, 1.txt-100.txt, content matching
# the filename, for manually testing panel scrolling/navigation).
/temp

# F2 user menu (explorer/user_menu) -- per-directory local files, left
# unanchored so they're caught wherever F2 creates/reads one (any
# subdirectory used while testing), not just the repo root. The .bak
# suffix covers the backups state::port_far_menu/
# backup_far_menu_without_porting make of either file before
# overwriting/moving it.
LitastumMenu.toml
LitastumMenu.toml.bak
FarMenu.ini
FarMenu.ini.bak